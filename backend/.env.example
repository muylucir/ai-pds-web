# backend/.env — pathfinder.app이 기동 시 자동 로드한다 (실 환경변수가 우선).
# 값은 `cd infra && npx cdk deploy` 출력(CfnOutputs)에서 가져온다.
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2

# 영속 스토리지(프로젝트 산출물 projects/* + strands 세션 sessions/*)
# 버킷이 만들어진 리전과 일치시킬 것 — CDK 기본은 서울(ap-northeast-2).
AIPDS_S3_REGION=ap-northeast-2
AIPDS_S3_BUCKET=aipdsdrillstack-artifacts...

# Bedrock 추론 프로파일 (에이전트가 백엔드에서 직접 호출)
# 폴백 모델. 프로젝트가 생성 시 고른 모델이 이것보다 우선한다(app.project_model).
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-8

# aiplc 룰 디렉토리 (미설정 시 <repo>/rule/aiplc-rules). 읽기 전용.
# AIPDS_RULES_DIR=/abs/path/to/rule/aiplc-rules
# 프로젝트별 로컬 워크스페이스 루트 (미설정 시 시스템 tmp 하위)
# AIPDS_WORKSPACES_DIR=/var/aipds/workspaces

AIPDS_CORS_ORIGINS=http://localhost:3000

# 프로토타입 생성 — 빌드 에이전트(Claude Agent SDK)는 백엔드 프로세스 안에서
# 직접 돈다(별도 VM 없음). 동시 빌드 상한(전역). 초과 시 세션 시작이 429.
# AIPDS_PROTO_MAX_CONCURRENT=2
# 빌드 에이전트 전용 CLAUDE_CONFIG_DIR. 미설정 시 번들 바이너리가 백엔드
# 실행 유저의 ~/.claude(개인 skills/agents/CLAUDE.md)를 읽어 워크숍 빌드마다
# 결과가 호스트 설정에 따라 달라질 수 있다 — 반드시 격리된 값을 준다.
# (CDK 배포 환경은 /opt/pathfinder/proto-config — 앱 트리 안. 로컬은 아래처럼
#  개인 ~/.claude와만 겹치지 않으면 어디든 된다.)
# AIPDS_PROTO_CONFIG_DIR=/home/ec2-user/aipds-proto-config
# 프로토타입 빌드 + 호스팅 공용 루트 (미설정 시 ~/aipds-protos)
# AIPDS_PROTO_ROOT=/var/aipds/protos

# ---- Discovery 드라이버 ----
# claude(기본) = Claude Agent SDK, strands = 구 드라이버(워크숍 중 탈출로).
# 알 수 없는 값은 배포 사고로 간주해 기동 시 ValueError.
# Discovery 에이전트 전용 CLAUDE_CONFIG_DIR. 미설정 시 호스트 유저의 ~/.claude가
# 섞인다 — proto용과 반드시 다른 경로여야 한다(discovery-config/README.md 참조).
# AIPDS_DISCOVERY_CONFIG_DIR=/home/ec2-user/aipds-discovery-config

# ---- 인증 (Cognito) ----
# 둘 다 비우면 인증이 전체 바이패스된다 — 로컬 개발과 테스트의 기본 상태다.
# 둘 다 채우면 인증이 켜진다. 단 하나만 채우면 배포 사고로 간주해 모든
# 요청에서 RuntimeError를 던진다(fail-closed) — 반드시 짝으로 채우거나 비운다.
# 값은 `cd infra && npx cdk deploy PathfinderAuthStack` 출력에서 가져온다.
#   UserPoolId       -> AIPDS_COGNITO_USER_POOL_ID
#   UserPoolClientId -> AIPDS_COGNITO_CLIENT_ID
AIPDS_COGNITO_USER_POOL_ID=
AIPDS_COGNITO_CLIENT_ID=
# 미지정 시 AIPDS_S3_REGION을 따른다.
AIPDS_COGNITO_REGION=
