# backend/.env — pathfinder.app이 기동 시 자동 로드한다 (실 환경변수가 우선).
# microvm 모드 값은 `cd infra && npx cdk deploy` 출력(CfnOutputs)에서 가져온다.
# local 모드만 쓸 거면 이 파일 없이 그냥 기동하면 된다.

AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1

# microvm | (미설정=local)
PATHFINDER_SANDBOX=microvm
PATHFINDER_VM_REGION=ap-northeast-1
# 드릴은 도쿄 통일; 코드 기본값은 서울(ap-northeast-2). CDK Artifacts 버킷 리전과 일치해야 한다.
PATHFINDER_S3_REGION=ap-northeast-1
PATHFINDER_VM_IMAGE_ID=arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:microvm-image:pathfinder-harness
PATHFINDER_VM_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/PathfinderDrillStack-ExecutionRole...
PATHFINDER_S3_BUCKET=pathfinderdrillstack-artifacts...
ANTHROPIC_MODEL=global.anthropic.claude-sonnet-5
PATHFINDER_CORS_ORIGINS=http://localhost:3000
