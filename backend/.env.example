# backend/.env — pathfinder.app이 기동 시 자동 로드한다 (실 환경변수가 우선).
# 값은 `cd infra && npx cdk deploy` 출력(CfnOutputs)에서 가져온다.
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2

# 영속 스토리지(프로젝트 산출물 projects/* + strands 세션 sessions/*)
# 버킷이 만들어진 리전과 일치시킬 것 — CDK 기본은 서울(ap-northeast-2).
PATHFINDER_S3_REGION=ap-northeast-2
PATHFINDER_S3_BUCKET=pathfinderdrillstack-artifacts...

# Bedrock 추론 프로파일 (에이전트가 백엔드에서 직접 호출)
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-8

# aiplc 룰 디렉토리 (미설정 시 <repo>/files/aiplc-rules). 읽기 전용.
# PATHFINDER_RULES_DIR=/abs/path/to/files/aiplc-rules
# 프로젝트별 로컬 워크스페이스 루트 (미설정 시 시스템 tmp 하위)
# PATHFINDER_WORKSPACES_DIR=/var/pathfinder/workspaces

PATHFINDER_CORS_ORIGINS=http://localhost:3000

# 프로토타입 생성(Tokyo MicroVM 빌드 + EC2 호스팅). 값은 `cd infra && npx cdk
# deploy PathfinderVmStack` 출력(CfnOutputs)에서 가져온다 — 이 스택은 항상
# Tokyo(도쿄)에 배포되므로 CDK_DEPLOY_REGION(위 인프라 배포 리전 선택)과는 무관하다.
# 미설정(PATHFINDER_VM_IMAGE_ID/ROLE_ARN 없음) 시 세션 시작이 502로 실패한다.
PATHFINDER_VM_REGION=ap-northeast-1
# VmStack 출력 `ImageArn`
# PATHFINDER_VM_IMAGE_ID=arn:aws:lambda:ap-northeast-1:<ACCOUNT_ID>:microvm-image:pathfinder-harness
# VmStack 출력 `ExecutionRoleArn`
# PATHFINDER_VM_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/Vm-ExecutionRole...
# 빌드된 프로토타입을 EC2 로컬에서 호스팅할 때 쓰는 루트 (미설정 시 ~/pathfinder-protos)
# PATHFINDER_PROTO_ROOT=/var/pathfinder/protos
