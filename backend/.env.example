# backend/.env — pathfinder.app이 기동 시 자동 로드한다 (실 환경변수가 우선).
# 값은 `cd infra && npx cdk deploy` 출력(CfnOutputs)에서 가져온다.
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2

# 영속 스토리지(프로젝트 산출물 projects/* + strands 세션 sessions/*)
# 버킷이 만들어진 리전과 일치시킬 것 — CDK 기본은 서울(ap-northeast-2).
PATHFINDER_S3_REGION=ap-northeast-2
PATHFINDER_S3_BUCKET=pathfinderdrillstack-artifacts...

# Bedrock 추론 프로파일 (에이전트가 백엔드에서 직접 호출)
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-8

# aiplc 룰 디렉토리 (미설정 시 <repo>/rule/aiplc-rules). 읽기 전용.
# PATHFINDER_RULES_DIR=/abs/path/to/rule/aiplc-rules
# 프로젝트별 로컬 워크스페이스 루트 (미설정 시 시스템 tmp 하위)
# PATHFINDER_WORKSPACES_DIR=/var/pathfinder/workspaces

PATHFINDER_CORS_ORIGINS=http://localhost:3000

# 프로토타입 생성 — 빌드 에이전트(Claude Agent SDK)는 백엔드 프로세스 안에서
# 직접 돈다(별도 VM 없음). 동시 빌드 상한(전역). 초과 시 세션 시작이 429.
# PATHFINDER_PROTO_MAX_CONCURRENT=2
# 빌드 에이전트 전용 CLAUDE_CONFIG_DIR. 미설정 시 번들 바이너리가 백엔드
# 실행 유저의 ~/.claude(개인 skills/agents/CLAUDE.md)를 읽어 워크숍 빌드마다
# 결과가 호스트 설정에 따라 달라질 수 있다 — 반드시 격리된 값을 준다.
# (CDK 배포 환경은 /opt/pathfinder/proto-config — 앱 트리 안. 로컬은 아래처럼
#  개인 ~/.claude와만 겹치지 않으면 어디든 된다.)
# PATHFINDER_PROTO_CONFIG_DIR=/home/ec2-user/pathfinder-proto-config
# 프로토타입 빌드 + 호스팅 공용 루트 (미설정 시 ~/pathfinder-protos)
# PATHFINDER_PROTO_ROOT=/var/pathfinder/protos
