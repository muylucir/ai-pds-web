# Local environment / secrets (contain account IDs, ARNs, per-env config)
.env
.env.*
!.env.example

# Reference material (gitignored working set)
files/

# SDD scratch (progress ledger, briefs, review packages)
.superpowers/

# 빌드 에이전트 config 루트의 런타임 산출물 (씨앗 skills/·agents/는 추적)
proto-config/projects/
proto-config/.credentials.json
proto-config/.claude.json
proto-config/settings.local.json
discovery-config/projects/
discovery-config/.credentials.json
discovery-config/.claude.json
discovery-config/settings.local.json
proto-type/
**/.pytest_cache/
**/__pycache__/
# 리포 루트에서 vitest/npx를 잘못 실행하면 .vite 캐시만 담긴 node_modules/가
# 생긴다(패키지 루트는 frontend/·infra/다). frontend/.gitignore가 그쪽을 이미
# 무시하므로 여기서는 루트만 막는다.
/node_modules/
.worktrees/
graphify-out/
# archify 스킬 산출물(HTML+JSON 다이어그램). graphify-out/과 같은 성격 —
# 리포의 코드에서 언제든 다시 생성되는 로컬 뷰다.
diagrams/
.vscode/
.claude/
