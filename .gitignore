# Local environment / secrets (contain account IDs, ARNs, per-env config)
.env
.env.*
!.env.example

# Reference material (gitignored working set)
files/

# SDD scratch (progress ledger, briefs, review packages)
.superpowers/

# 설계 스펙·구현 플랜(SDD 산출물). 3de42ec에서 사내 산출문서를 지우고 공개
# 리포로 전환했으므로, 같은 경로에 새로 쓰는 문서도 추적하지 않는다 —
# 관례(docs/superpowers/specs/YYYY-MM-DD-<주제>-design.md)는 로컬에서 그대로 쓴다.
docs/

# 빌드 에이전트 config 루트의 런타임 산출물 (씨앗 skills/·agents/는 추적)
proto-config/projects/
proto-config/.credentials.json
proto-config/.claude.json
proto-config/settings.local.json
discovery-config/projects/
discovery-config/.credentials.json
discovery-config/.claude.json
discovery-config/settings.local.json
proto-type/
**/.pytest_cache/
**/__pycache__/
# 리포 루트에서 vitest/npx를 잘못 실행하면 .vite 캐시만 담긴 node_modules/가
# 생긴다(패키지 루트는 frontend/·infra/다). frontend/.gitignore가 그쪽을 이미
# 무시하므로 여기서는 루트만 막는다.
/node_modules/
.worktrees/
graphify-out/
# archify 스킬 산출물(HTML+JSON 다이어그램). graphify-out/과 같은 성격 —
# 리포의 코드에서 언제든 다시 생성되는 로컬 뷰다.
diagrams/
.vscode/
.claude/

# rule/ 은 통째로 무시한다. 2026-08-21까지 상류 룰셋의 사본이 있던 자리이고,
# 이제 룰셋은 `steering-files/` 서브모듈이므로 여기에 추적할 것이 없다.
#
# 그래도 남겨 두는 이유(2026-08-17): 로컬 개발 설정이 `AIPDS_WORKSPACES_DIR`을 이
# 레포의 `rule/`로 잡아 두면 프로젝트 워크스페이스가 그 아래에 만들어지고, 루트에서
# `git add -A`를 하면 그대로 추적된다. 실제로 그렇게 들어갔고
# `infra/test/deployed-tree.assert.ts`가 잡았다 — 그 워크스페이스에는 조립된
# `CLAUDE.md`가 있고, 배포 트리에서 워크스페이스의 **조상**이 되는 CLAUDE.md는
# 전부 에이전트 컨텍스트로 로드된다(README가 기록한 사고와 같은 부류다).
# 그 설정을 아직 쓰는 트리가 있으므로 가드를 유지한다.
/rule/
