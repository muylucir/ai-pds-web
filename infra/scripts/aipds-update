#!/bin/bash
# 이 인스턴스를 배포 브랜치의 원격 최신 커밋으로 맞춘다.
#
# 왜 이 스크립트가 필요한가: 배포는 커밋 SHA가 아니라 브랜치를 가리킨다
# (lib/deploy-source.ts). 그래서 user-data가 코드 변경과 무관하게 동일하고,
# `cdk deploy`는 인스턴스를 교체하지 않는다 — 즉 **코드를 갱신하지 않는다.**
# 그 일을 하는 것이 이 스크립트이고, 인스턴스 교체가 없으므로 워크숍 중에도 쓸 수 있다.
#
# 왜 손으로 하지 않는가: 절차에 **잊으면 앱이 조용히 죽는** 단계가 있다.
# next build에서 NEXT_PUBLIC_API_BASE_URL=/api를 빼면 그 값이 클라이언트 번들에
# 인라인되지 않아 브라우저가 localhost:8000을 부른다 — 화면은 뜨고 모든 API 호출이
# 죽는다. 재시작 범위를 바뀐 디렉터리로 좁히는 것도 같은 이유다: 백엔드 재시작은
# 진행 중인 Discovery 턴과 빌드 세션을 끊고, 프론트 재빌드는 접속 중인 사용자에게
# 청크 404를 낸다. rule/만 바뀐 갱신(워크숍에서 가장 흔한 경우)은 무중단으로 끝난다.
#
# 이 파일은 리포에 있고 user-data가 부팅 때 /usr/local/bin/으로 install한다.
# user-data에 heredoc으로 박지 않는 이유 둘: EC2 user-data는 16KB 한계가 있고(한 번
# 넘겨서 배포가 실패한 적이 있다), user-data를 편집하면 EC2가 인스턴스 교체를
# 요구해서 protos/·workspaces/의 로컬 산출물이 날아간다. 리포 파일이면 이 스크립트를
# 고치는 것 자체가 `aipds-update`로 반영된다.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "aipds-update: run as root (sudo aipds-update)" >&2
  exit 1
fi

# 경로·유저·브랜치는 CDK가 정한다(lib/user-data.ts가 부팅 때 이 파일을 쓴다) —
# 여기에 리터럴로 박으면 DEPLOY_BRANCH를 바꿨을 때 조용히 어긋난다.
ENV_FILE=/etc/aipds-deploy.env
if [ ! -r "$ENV_FILE" ]; then
  echo "aipds-update: $ENV_FILE not found — this instance predates the split-out" \
       "script; re-deploy the stack or write APP/SVC/BRANCH into it by hand" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$ENV_FILE"
: "${APP:?APP missing in $ENV_FILE}"
: "${SVC:?SVC missing in $ENV_FILE}"
: "${BRANCH:?BRANCH missing in $ENV_FILE}"

# git을 SVC로 도는 이유: 트리는 SVC 소유이고, root로 fetch하면 새 오브젝트가 root
# 소유로 섞여 **다음** 갱신이 권한으로 막힌다 — 그 실패는 갱신할 때만 보인다.
gitsvc() { runuser -u "$SVC" -- git -C "$APP" "$@"; }

BEFORE=$(gitsvc rev-parse HEAD)
gitsvc fetch --prune origin
# -f: 인스턴스에서 손으로 고친 tracked 파일은 **되돌아간다.** 그것 없이는 그런 파일
# 하나가 갱신 전체를 거부시킨다 — 워크숍 중에 그 상태로 멈추는 것이 더 나쁘다.
# untracked(protos/·workspaces/·세션 상태)는 이 명령으로 지워지지 않는다.
gitsvc checkout -f -B "$BRANCH" "origin/$BRANCH"
AFTER=$(gitsvc rev-parse HEAD)

if [ "$BEFORE" = "$AFTER" ]; then
  echo "aipds-update: already at $AFTER — nothing to do, services untouched"
  exit 0
fi
echo "aipds-update: $BEFORE -> $AFTER"
gitsvc --no-pager log --oneline "$BEFORE..$AFTER"

changed() { ! gitsvc diff --quiet "$BEFORE" "$AFTER" -- "$1"; }

# 이 스크립트 자신이 바뀌었으면 새 것을 깔아 둔다(다음 실행부터 적용된다).
if changed infra/scripts/aipds-update; then
  install -m 755 "$APP/infra/scripts/aipds-update" /usr/local/bin/aipds-update
  echo "aipds-update: self-updated — the next run uses the new script"
fi

if changed backend/; then
  # 의존성이 바뀐 경우만 다시 설치한다. 코드는 pip install -e 라 그대로 반영된다.
  if changed backend/pyproject.toml; then
    runuser -u "$SVC" -- "$APP/backend/.venv/bin/pip" install -e "$APP/backend"
  fi
  # claude-agent-sdk는 하한만 걸려 있으므로(backend/pyproject.toml) 위 install은
  # 이미 깔린 버전으로 만족해 버린다 — 최신을 받는 것은 이 -U 한 줄이다. 그래서
  # pyproject.toml 게이트 **밖에** 있다: 의존성 줄이 안 바뀌어도 올라가야 한다.
  #
  # 위치가 restart 바로 위인 것도 의도다. 이 wheel은 Claude Code 실행 바이너리를
  # 번들하므로 업그레이드가 곧 엔진 교체이고, 재시작 없이 갈면 살아 있는 백엔드는
  # 낡은 프로세스인데 새로 뜨는 자식만 새 바이너리가 되어 섞인다.
  # rule/만 바뀐 무중단 갱신은 이 블록에 아예 들어오지 않아 엔진이 그대로다.
  runuser -u "$SVC" -- "$APP/backend/.venv/bin/pip" install -U claude-agent-sdk
  systemctl restart aipds-backend
  echo "aipds-update: backend restarted (in-flight turns and build sessions were cut)"
fi

if changed frontend/; then
  cd "$APP/frontend"
  if changed frontend/package-lock.json; then
    runuser -u "$SVC" -- env NEXT_PUBLIC_API_BASE_URL=/api HOME="$APP" npm ci
  fi
  # 이 env를 빼고 빌드하면 화면은 뜨고 모든 API 호출이 죽는다(파일 상단 주석 참조).
  runuser -u "$SVC" -- env NEXT_PUBLIC_API_BASE_URL=/api HOME="$APP" npm run build
  systemctl restart aipds-frontend
  echo "aipds-update: frontend rebuilt and restarted"
fi

echo "aipds-update: now at $AFTER"
