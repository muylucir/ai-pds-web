#!/usr/bin/python3 -I
# 에이전트·프로토타입 프로세스를 백엔드와 다른 uid, 자기 프로젝트 트리만 보이는 샌드박스에서
# 띄운다. 백엔드(aipds)가 sudo로 부른다 — 이 파일은 **root가 되는 길**이다.
#
#   aipds-launch run   <kind> <project_id> [<slug>] -- <args…>
#   aipds-launch stop  <kind> <project_id> <slug>
#   aipds-launch sweep
#   aipds-launch check
#
# 설치: `aipds-harden install`이 이 파일을 /usr/local/libexec/aipds/launch(root 0755)로
# **복사**하고 sudoers가 그 사본만 허용한다. 리포 안의 이 파일은 aipds가 쓸 수 있으므로
# sudoers가 이것을 직접 가리키면 aipds가 root를 얻는다.
#
# 규칙(모든 입력은 불신한다):
# - 경로는 kind·project_id·slug로 **계산**한다. 호출자가 경로를 주지 않는다.
# - 실행 파일은 kind가 정한다(claude 번들 바이너리 또는 /usr/bin/npm). npm 인자는 허용목록.
# - env는 이름 허용목록만 넘기고, 값이 중요한 것(자격증명 URI, PORT)은 형식을 검사한다.
# - 인자는 셸을 거치지 않는다(배열로 exec). systemd가 ExecStart 인자의 `${VAR}`를 풀기
#   때문에 모든 인자의 `$`를 `$$`로 이스케이프한다(실측: systemd 252).
#
# 격리(실측 근거는 docs 계획 3·4-BC §6.1):
# - unit은 root로 시작해 `unshare --pid --mount-proc`로 PID 네임스페이스를 만든 뒤
#   `setpriv`로 kind의 uid로 내린다. 같은 uid의 다른 unit이 `/proc/<pid>/root`로 서로의
#   마운트 네임스페이스를 읽을 수 있기 때문이다(ProtectProc=invisible은 다른 uid만 숨긴다).
# - workspaces/·protos/·agent-home/ 전체를 빈 tmpfs로 덮고 자기 트리만 다시 bind한다.
# - IMDS 차단은 unit별 IPAddressDeny(cgroup BPF) — 인스턴스에 iptables가 없다.
#   /etc/aipds/launch.conf의 `imds_block=1`일 때만(`aipds-harden imds block`).
from __future__ import annotations

import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
from pathlib import Path

APP = Path("/opt/aipds")
WORKSPACES = APP / "workspaces"
PROTOS = APP / "protos"
AGENT_HOME = APP / "agent-home"
CONF = Path("/etc/aipds/launch.conf")
CLAUDE_GLOB = "backend/.venv/lib/python3*/site-packages/claude_agent_sdk/_bundled/claude"
NPM = "/usr/bin/npm"
SYSTEMD_RUN = "/usr/bin/systemd-run"
SYSTEMCTL = "/usr/bin/systemctl"
UNSHARE = "/usr/bin/unshare"
SETPRIV = "/usr/bin/setpriv"
GROUP = "aipds-work"
UNIT_PREFIX = "aipds-run-"

#: kind → (uid, 실행 파일 종류, slug 필요 여부, MemoryMax). 메모리는 A 단계에서 실측 교정.
KINDS = {
    "discovery": ("aipds-agent", "claude", False, "1G"),
    "build": ("aipds-agent", "claude", True, "3G"),
    "host-build": ("aipds-proto", "npm", True, "3G"),
    "proto": ("aipds-proto", "npm", True, "512M"),
}

#: npm kind가 받는 인자 전부. 여기 없는 조합은 거부한다.
NPM_ARGS = {
    "host-build": (("install",), ("run", "build")),
    "proto": (("run", "start"), ("run", "dev")),
}

#: 호스팅 kind는 unit 이름이 결정적이어야 한다 — `stop`이 이름으로 찾는다
#: (systemd-run 클라이언트를 죽여도 unit은 멈추지 않는다, 실측).
DETERMINISTIC = {"host-build", "proto"}

#: 그대로 넘기는 env 이름. sudoers의 env_keep과 같은 목록이어야 한다(aipds-harden).
PASS_EXACT = {
    "ANTHROPIC_MODEL", "AWS_REGION", "AWS_DEFAULT_REGION",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN",
    "NEXT_PUBLIC_BASE_PATH", "PROTO_BASE_PATH", "BEDROCK_MODEL_ID",
}
PASS_PREFIX = ("CLAUDE_CODE_", "CLAUDE_AGENT_SDK_")
#: 값의 형식까지 보는 env. 맞지 않으면 버린다.
PASS_CHECKED = {
    # 루프백의 백엔드 자격증명 엔드포인트만(aipds/credentials.py). 다른 주소를 허용하면
    # 에이전트의 AWS SDK가 호출자가 고른 곳에서 자격증명을 받는다.
    "AWS_CONTAINER_CREDENTIALS_FULL_URI":
        re.compile(r"http://127\.0\.0\.1:[0-9]{1,5}/[A-Za-z0-9/_-]*\Z"),
    "PORT": re.compile(r"[0-9]{1,5}\Z"),
}

#: 경로 세그먼트로 쓰지 못하는 문자. `/`·NUL은 경로를, 공백·`:`·따옴표·`\`는 systemd의
#: BindPaths 목록 파싱을, `%`·`$`는 systemd 치환을 깬다. 한글 project id는 통과한다.
_BAD_SEGMENT = re.compile(r"[/\x00-\x20\x7f:\"'\\%$]")


class LaunchError(Exception):
    pass


def check_segment(value: str, what: str) -> str:
    if (not value or value in (".", "..") or len(value.encode("utf-8")) > 200
            or _BAD_SEGMENT.search(value)):
        raise LaunchError(f"invalid {what}: {value!r}")
    return value


def read_conf(path: Path = CONF) -> dict[str, str]:
    """`key=value` 줄. 없으면 빈 dict(= IMDS 차단 꺼짐)."""
    conf: dict[str, str] = {}
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return conf
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            conf[key.strip()] = value.strip()
    return conf


def unit_name(kind: str, project_id: str, slug: str | None) -> str:
    """unit 이름. project id가 임의 문자열(한글 포함)이라 이름에는 해시를 쓴다 — 이스케이프가
    필요 없고, `a-b`+`c`와 `a`+`b-c`가 부딪히지 않는다. 사람이 읽을 값은 Description에."""
    digest = hashlib.sha256(f"{project_id}\0{slug or ''}".encode("utf-8")).hexdigest()[:16]
    name = f"{UNIT_PREFIX}{kind}-{digest}"
    if kind not in DETERMINISTIC:
        # 에이전트는 같은 프로젝트에서 겹쳐 뜰 수 있다(재연결 직후 이전 프로세스가 아직 끝나는 중).
        name += "-" + secrets.token_hex(4)
    return name + ".service"


def layout(kind: str, project_id: str, slug: str | None) -> tuple[Path, Path]:
    """(작업 디렉터리, agent-home). 둘 다 RW로 bind되는 유일한 경로다."""
    if kind == "discovery":
        return WORKSPACES / project_id, AGENT_HOME / "discovery" / project_id
    assert slug is not None
    if kind == "build":
        return PROTOS / project_id / slug, AGENT_HOME / "build" / project_id / slug
    return (PROTOS / project_id / slug / "prototype",
            AGENT_HOME / "proto" / project_id / slug)


def _real_dir(path: Path) -> Path:
    """존재하는 실제 디렉터리여야 한다. 경로 어디에도 심볼릭 링크가 끼면 거부 — 링크로
    다른 곳(다른 프로젝트, /etc)을 RW bind하게 만드는 길을 막는다."""
    if os.path.realpath(path) != str(path) or not path.is_dir():
        raise LaunchError(f"not a real directory: {path}")
    return path


def find_claude(app: Path = APP) -> Path:
    found = sorted(app.glob(CLAUDE_GLOB))
    if len(found) != 1:
        raise LaunchError(f"expected one bundled claude, found {len(found)}")
    return found[0]


def pass_env(environ: dict[str, str]) -> dict[str, str]:
    out: dict[str, str] = {}
    for key, value in environ.items():
        if key in PASS_EXACT or key.startswith(PASS_PREFIX):
            out[key] = value
        elif key in PASS_CHECKED and PASS_CHECKED[key].match(value):
            out[key] = value
    return out


def _dollar(arg: str) -> str:
    return arg.replace("$", "$$")


def build_run(kind: str, project_id: str, slug: str | None, args: list[str],
              environ: dict[str, str], conf: dict[str, str],
              claude: Path | None = None) -> tuple[list[str], dict[str, str]]:
    """systemd-run argv와 그 프로세스의 env. 부작용 없음 — 테스트가 이것을 직접 부른다."""
    if kind not in KINDS:
        raise LaunchError(f"unknown kind: {kind!r}")
    user, exe_kind, needs_slug, memory = KINDS[kind]
    check_segment(project_id, "project id")
    if needs_slug:
        if slug is None:
            raise LaunchError(f"{kind} needs a slug")
        check_segment(slug, "slug")
    elif slug is not None:
        raise LaunchError(f"{kind} takes no slug")

    work, home = layout(kind, project_id, slug)
    _real_dir(work)
    _real_dir(home)
    _real_dir(home / "home")

    env = pass_env(environ)
    env["HOME"] = str(home / "home")
    env["PATH"] = "/usr/local/bin:/usr/bin:/bin"
    if exe_kind == "claude":
        _real_dir(home / "config")
        # 호출자가 준 값은 쓰지 않는다 — 공유 config dir을 가리키면 다른 프로젝트의
        # 트랜스크립트가 보인다.
        env["CLAUDE_CONFIG_DIR"] = str(home / "config")
        command = [str(claude or find_claude()), *args]
    else:
        if tuple(args) not in NPM_ARGS[kind]:
            raise LaunchError(f"{kind}: npm {' '.join(args)!r} is not allowed")
        command = [NPM, *args]

    label = project_id if slug is None else f"{project_id}/{slug}"
    props = [
        f"Description=AI-PDS {kind} {label}",
        "Type=exec",
        f"WorkingDirectory={work}",
        "UMask=0007",
        f"MemoryMax={memory}",
        "TimeoutStopSec=10",
        "ProtectSystem=strict",
        "ProtectHome=yes",
        "PrivateTmp=yes",
        "PrivateDevices=yes",
        "NoNewPrivileges=yes",
        "ProtectKernelTunables=yes",
        "ProtectKernelModules=yes",
        "ProtectKernelLogs=yes",
        "ProtectControlGroups=yes",
        "ProtectClock=yes",
        "ProtectHostname=yes",
        "RestrictRealtime=yes",
        "RestrictSUIDSGID=yes",
        "LockPersonality=yes",
        # unshare에 필요한 둘만. 사용자 네임스페이스를 막아 권한을 되찾는 길을 닫는다.
        "RestrictNamespaces=pid mnt",
        "CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP",
        f"TemporaryFileSystem={WORKSPACES}",
        f"TemporaryFileSystem={PROTOS}",
        f"TemporaryFileSystem={AGENT_HOME}",
        # 시크릿이 평문으로 있는 곳(unit 파일, nginx 설정, 백엔드 설정). 파일 권한이 1차 방어이고
        # 이것은 겹쳐 두는 것이다.
        "InaccessiblePaths=-/etc/aipds",
        "InaccessiblePaths=-/etc/nginx",
        "InaccessiblePaths=-/etc/systemd/system",
        "InaccessiblePaths=-/etc/sudoers.d",
        f"BindPaths={work}",
        f"BindPaths={home}",
    ]
    if conf.get("imds_block") == "1":
        props.append("IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128")

    trampoline = [
        UNSHARE, "--pid", "--fork", "--mount-proc", "--kill-child", "--",
        SETPRIV, f"--reuid={user}", f"--regid={GROUP}", "--init-groups",
        "--inh-caps=-all", "--bounding-set=-all", "--no-new-privs", "--",
    ]
    argv = [SYSTEMD_RUN, "--pipe", "--wait", "--collect", "--quiet",
            f"--unit={unit_name(kind, project_id, slug)}"]
    argv += [f"--property={p}" for p in props]
    # 이름만 준다 — 값은 systemd-run 자신의 env에서 읽는다. argv에 값이 실리면 자격증명
    # 토큰이 `ps`에 보인다.
    argv += [f"--setenv={key}" for key in sorted(env)]
    argv += ["--", *trampoline, *[_dollar(a) for a in command]]
    return argv, env


def build_stop(kind: str, project_id: str, slug: str) -> list[str]:
    if kind not in DETERMINISTIC:
        raise LaunchError(f"stop is only for {sorted(DETERMINISTIC)}")
    check_segment(project_id, "project id")
    check_segment(slug, "slug")
    return [SYSTEMCTL, "stop", unit_name(kind, project_id, slug)]


def check_report() -> dict:
    """백엔드 기동 점검용. 백엔드는 자기 경로가 여기 값과 같을 때만 래퍼를 쓴다."""
    try:
        claude = str(find_claude())
    except LaunchError:
        claude = None
    return {
        "version": 1,
        "workspaces": str(WORKSPACES),
        "protos": str(PROTOS),
        "agent_home": str(AGENT_HOME),
        "claude": claude,
        "npm": os.access(NPM, os.X_OK),
        "imds_block": read_conf().get("imds_block") == "1",
    }


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("aipds-launch: must run as root (via sudo)", file=sys.stderr)
        return 2
    try:
        if len(argv) >= 1 and argv[0] == "run":
            if "--" not in argv:
                raise LaunchError("run needs `--` before the command arguments")
            sep = argv.index("--")
            head, args = argv[1:sep], argv[sep + 1:]
            if len(head) not in (2, 3):
                raise LaunchError("usage: run <kind> <project_id> [<slug>] -- <args…>")
            kind, project_id = head[0], head[1]
            slug = head[2] if len(head) == 3 else None
            run_argv, env = build_run(kind, project_id, slug, args,
                                      dict(os.environ), read_conf())
            os.execve(SYSTEMD_RUN, run_argv, env)
        if len(argv) == 4 and argv[0] == "stop":
            return subprocess.run(build_stop(argv[1], argv[2], argv[3]),
                                  check=False).returncode
        if argv == ["sweep"]:
            # 백엔드가 재시작하면 systemd-run 클라이언트는 함께 죽지만 unit은 남는다.
            return subprocess.run([SYSTEMCTL, "stop", f"{UNIT_PREFIX}*.service"],
                                  check=False).returncode
        if argv == ["check"]:
            print(json.dumps(check_report()))
            return 0
        raise LaunchError("usage: aipds-launch run|stop|sweep|check …")
    except LaunchError as exc:
        print(f"aipds-launch: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
