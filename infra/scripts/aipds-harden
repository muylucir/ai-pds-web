#!/bin/bash
# 에이전트·프로토타입을 백엔드와 다른 uid의 샌드박스에서 돌리기 위한 인스턴스 설정.
#
#   sudo /opt/aipds/infra/scripts/aipds-harden install [--no-restart]
#   sudo /opt/aipds/infra/scripts/aipds-harden boot
#   sudo /opt/aipds/infra/scripts/aipds-harden sync
#   sudo /opt/aipds/infra/scripts/aipds-harden enable <AgentRoleArn>
#   sudo /opt/aipds/infra/scripts/aipds-harden disable
#   sudo /opt/aipds/infra/scripts/aipds-harden imds block|allow
#   sudo /opt/aipds/infra/scripts/aipds-harden status
#
# install  유저(aipds-agent, aipds-proto)·그룹(aipds-work), 래퍼 설치와 sudoers, 트리 권한,
#          평문 시크릿의 권한, sync 타이머. **래퍼 설정(enable·imds)은 건드리지 않는다** — 새 인스턴스라면 꺼진
#          채이고, 실행 중인 인스턴스라면 켜 둔 그대로다. 기반만 깐다. 멱등.
# enable   래퍼를 켠다(AIPDS_LAUNCHER=1 + AgentRole). AgentRole은 AipdsAgentCredsStack의 출력.
# imds     래퍼가 띄운 프로세스의 IMDS 접근. **enable 뒤 Bedrock 호출이 되는 것을 확인하고
#          block한다** — 거꾸로 하면 에이전트와 프로토타입의 LLM 호출이 함께 끊긴다.
# sync     별도 스택이 SSM에 남긴 값(infra/lib/instance-params.ts)을 인스턴스에 반영한다: AgentRole이
#          있으면 enable + imds block, 프리뷰 값이 있으면 프리뷰 설정. 바뀐 것이 있고 백엔드가 떠
#          있으면 재시작한다. **타이머(aipds-harden-sync.timer)가 2분마다 돌린다** — 새 환경의
#          `cdk deploy --all`에서 인스턴스는 HostingStack과 함께 먼저 부팅하고, 두 스택은 그 뒤에
#          값을 쓴다. 부팅 때 한 번 읽는 것으로는 그 값을 못 본다.
#          값이 없거나 읽지 못하면 아무것도 바꾸지 않는다(끄지 않는다). `disable`·`imds allow`는
#          운영자의 선택이라 동기화를 멈춘다(`/etc/aipds/hold`) — `enable`·`imds block`이 푼다.
#          첫 롤아웃의 "확인 뒤 block" 순서는 이미 검증된 구성을 다시 까는 데는 필요 없다.
# boot     새 인스턴스의 user-data가 서비스 기동 **전에** 부른다. install + sync(재시작 없음).
#
# 왜 user-data가 아니라 이 스크립트인가: user-data를 바꾸면 HostingStack 배포가 EC2를
# 교체한다(aipds-preview-configure와 같은 사정). user-data는 새 인스턴스에서 `boot`를
# 부르고, 실행 중인 인스턴스에는 SSM으로 이것을 돌린다.
#
# enable·disable·imds·install은 백엔드를 재시작한다 — 진행 중인 턴과 빌드가 끊긴다. sync는 값이
# 바뀌었을 때만.
#
# 타이머가 root로 돌리는 것은 root 소유 사본(/usr/local/libexec/aipds/harden)이다. 리포 안의 이
# 파일은 aipds가 쓸 수 있으므로, 타이머가 이것을 직접 돌리면 aipds가 root를 얻는다(래퍼와 같은 이유).
set -euo pipefail
if [ "$(id -u)" -ne 0 ]; then
  echo "aipds-harden: run as root" >&2
  exit 1
fi

ENV_FILE=/etc/aipds-deploy.env
APP=/opt/aipds
SVC=aipds
if [ -r "$ENV_FILE" ]; then
  # shellcheck source=/dev/null
  . "$ENV_FILE"
fi
# 래퍼(aipds-launch)는 이 경로를 상수로 갖는다 — 다르면 기동 점검이 래퍼를 끈다.
if [ "$APP" != /opt/aipds ]; then
  echo "aipds-harden: APP=$APP but the launcher is built for /opt/aipds" >&2
  exit 1
fi

GROUP=aipds-work
LIBEXEC=/usr/local/libexec/aipds
SUDOERS=/etc/sudoers.d/aipds-launch
CONF_DIR=/etc/aipds
LAUNCH_CONF=$CONF_DIR/launch.conf
DROPIN=/etc/systemd/system/aipds-backend.service.d
FRONT_UNIT=/etc/systemd/system/aipds-frontend.service
FRONT_DROPIN=/etc/systemd/system/aipds-frontend.service.d
FRONT_ENV=$CONF_DIR/frontend.env
# infra/lib/instance-params.ts와 같은 이름(test/instance-params.assert.ts).
PARAM_AGENT_ROLE=/aipds/agent-role-arn
PARAM_PREVIEW_ORIGIN=/aipds/preview-origin
PARAM_PREVIEW_SECRET=/aipds/preview-secret-arn
HOLD=$CONF_DIR/hold
SYNC_UNIT=aipds-harden-sync

restart_backend() {
  systemctl daemon-reload
  systemctl restart aipds-backend
  echo "aipds-harden: backend restarted"
}

write_launcher() {
  mkdir -p "$DROPIN"
  cat > "$DROPIN/launcher.conf" <<UNIT
[Service]
Environment=AIPDS_LAUNCHER=1
Environment=AIPDS_AGENT_ROLE_ARN=$1
UNIT
  chmod 644 "$DROPIN/launcher.conf"
}

# 운영자가 고른 상태를 동기화가 되돌리지 않게.
hold() {
  mkdir -p "$CONF_DIR"
  printf '%s at %s\n' "$1" "$(date -u +%FT%TZ)" > "$HOLD"
}

write_imds() {
  printf 'imds_block=%s\n' "$1" > "$LAUNCH_CONF"
  chmod 644 "$LAUNCH_CONF"
}

# 파라미터 값. 없으면 빈 문자열(스택 미배포). 그 밖의 실패(권한, 네트워크)는 몇 번 다시 묻고
# 그래도 안 되면 빈 문자열 — 부팅을 막지는 않되 로그에 크게 남긴다.
get_param() {
  local out i
  for i in 1 2 3; do
    if out=$(aws ssm get-parameter --region "$REGION" --name "$1" \
        --query Parameter.Value --output text 2>&1); then
      printf '%s' "$out"
      return 0
    fi
    case "$out" in *ParameterNotFound*) return 0 ;; esac
    sleep $((i * 5))
  done
  echo "aipds-harden: WARNING cannot read $1: $out" >&2
}

# sudo는 AWS_REGION을 지운다 — 없으면 IMDS에서 읽는다(호스트 root는 닿는다. 막는 것은 샌드박스 unit뿐).
instance_region() {
  local token
  token=$(curl -sf -m 3 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
    http://169.254.169.254/latest/api/token) || return 0
  curl -sf -m 3 -H "X-aws-ec2-metadata-token: $token" \
    http://169.254.169.254/latest/meta-data/placement/region || true
}

# 동기화가 쓰는 세 파일. 없는 파일이 있어도(새 인스턴스) 실패하지 않는다 — set -e/pipefail이다.
settings_digest() {
  local f
  for f in "$DROPIN/launcher.conf" "$DROPIN/preview.conf" "$LAUNCH_CONF"; do
    printf '%s\n' "$f"
    if [ -e "$f" ]; then cat "$f"; fi
  done | sha256sum
}

settings_summary() {
  local launcher=off imds preview=off
  [ -e "$DROPIN/launcher.conf" ] && launcher=on
  imds=$(sed -n 's/^imds_block=//p' "$LAUNCH_CONF" 2>/dev/null || true)
  [ -e "$DROPIN/preview.conf" ] && preview=on
  echo "launcher=$launcher imds_block=${imds:-?} preview=$preview"
}

# 스택이 남긴 값을 반영한다. $1=1이면 바뀐 것이 있을 때 백엔드를 재시작한다(떠 있을 때만).
sync_apply() {
  local restart=$1
  if [ -e "$HOLD" ]; then
    echo "aipds-harden: sync held ($HOLD — 'enable' or 'imds block' releases it)"
    return 0
  fi
  REGION=${AWS_REGION:-${AWS_DEFAULT_REGION:-$(instance_region)}}
  if [ -z "$REGION" ]; then
    echo "aipds-harden: WARNING no region (AWS_REGION unset, IMDS unreachable) — launcher and" \
      "preview settings not applied (existing ones unchanged)" >&2
    return 0
  fi
  local before after arn origin secret
  before=$(settings_digest)
  arn=$(get_param "$PARAM_AGENT_ROLE")
  case "$arn" in
    # 래퍼 없이 IMDS만 막으면 아무것도 막지 않는다(IPAddressDeny는 래퍼가 띄운 unit에만 걸린다).
    arn:aws:iam::*:role/*)
      write_launcher "$arn"
      write_imds 1
      ;;
    *) echo "aipds-harden: WARNING no $PARAM_AGENT_ROLE — launcher settings not applied (existing" \
         "ones unchanged; until AipdsAgentCredsStack is deployed a new instance runs agents and" \
         "prototypes unsandboxed)" >&2 ;;
  esac
  origin=$(get_param "$PARAM_PREVIEW_ORIGIN")
  secret=$(get_param "$PARAM_PREVIEW_SECRET")
  if [ -n "$origin" ] && [ -n "$secret" ]; then
    # 값이 잘못돼도 멈추지 않는다 — boot는 user-data(set -e) 안이고, 멈추면 앱 전체가 502다.
    "$LIBEXEC/preview-configure" --no-restart "$origin" "$secret" >/dev/null \
      || echo "aipds-harden: WARNING preview parameters rejected — served from the app origin" >&2
  else
    echo "aipds-harden: no preview parameters — preview settings not applied (existing ones unchanged)" >&2
  fi
  after=$(settings_digest)
  if [ "$before" = "$after" ]; then
    echo "aipds-harden: sync — no change"
    return 0
  fi
  systemctl daemon-reload
  echo "aipds-harden: sync — applied: $(settings_summary)"
  if [ "$restart" = 1 ] && systemctl is-active --quiet aipds-backend; then
    restart_backend
  fi
}

install_all() {
  local restart=1
  [ "${1:-}" = "--no-restart" ] && restart=0

  # --- 유저와 그룹. 로그인 셸·홈 없음 — HOME은 래퍼가 에이전트 홈으로 준다. ---
  getent group "$GROUP" >/dev/null || groupadd --system "$GROUP"
  for u in aipds-agent aipds-proto; do
    id -u "$u" >/dev/null 2>&1 || useradd --system --no-create-home --home-dir /nonexistent \
      --shell /sbin/nologin --gid "$GROUP" "$u"
  done
  # 백엔드가 에이전트가 쓴 파일을 읽고 지운다.
  usermod -aG "$GROUP" "$SVC"

  # --- 래퍼. 리포 안의 파일은 aipds가 쓸 수 있으므로 root 소유 사본만 sudoers에 건다. ---
  install -d -o root -g root -m 0755 "$LIBEXEC"
  install -o root -g root -m 0755 "$APP/infra/scripts/aipds-launch" "$LIBEXEC/launch"
  install -o root -g root -m 0755 "$APP/infra/scripts/aipds-claude" "$LIBEXEC/claude"
  install -o root -g root -m 0755 "$APP/infra/scripts/aipds-harden" "$LIBEXEC/harden"
  install -o root -g root -m 0755 "$APP/infra/scripts/aipds-preview-configure" "$LIBEXEC/preview-configure"

  # env_keep은 래퍼의 PASS_EXACT/PASS_PREFIX/PASS_CHECKED와 같은 목록이다. 래퍼가 다시 거른다.
  # !log_allowed: 호출마다 CLI 인자 전체(시스템 프롬프트, MCP 설정)가 syslog에 남지 않게.
  local tmp
  tmp=$(mktemp)
  cat > "$tmp" <<SUDO
Defaults!$LIBEXEC/launch env_keep += "CLAUDE_CODE_* CLAUDE_AGENT_SDK_* ANTHROPIC_MODEL AWS_REGION AWS_DEFAULT_REGION AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_AUTHORIZATION_TOKEN NEXT_PUBLIC_BASE_PATH PROTO_BASE_PATH BEDROCK_MODEL_ID PORT"
Defaults!$LIBEXEC/launch !log_allowed
$SVC ALL=(root) NOPASSWD: $LIBEXEC/launch
SUDO
  visudo -cqf "$tmp"
  install -o root -g root -m 0440 "$tmp" "$SUDOERS"
  rm -f "$tmp"

  # --- 트리. 백엔드와 샌드박스 uid가 그룹으로 함께 쓴다. other는 없다. ---
  install -d -o "$SVC" -g "$GROUP" -m 0770 "$APP/agent-home"
  for d in "$APP/workspaces" "$APP/protos" "$APP/agent-home"; do
    mkdir -p "$d"
    chgrp -R "$GROUP" "$d"
    chmod -R g+rwX,o-rwx "$d"
  done

  # --- 백엔드: 새 파일이 그룹 aipds-work로, 그룹 쓰기로 생기게. 에이전트 홈 경로는 래퍼와 같게. ---
  mkdir -p "$DROPIN"
  cat > "$DROPIN/sandbox.conf" <<UNIT
[Service]
Group=$GROUP
UMask=0007
Environment=AIPDS_AGENT_HOME_DIR=$APP/agent-home
UNIT
  chmod 644 "$DROPIN/sandbox.conf"

  install -d -o root -g root -m 0755 "$CONF_DIR"
  [ -e "$LAUNCH_CONF" ] || printf 'imds_block=0\n' > "$LAUNCH_CONF"
  chmod 644 "$LAUNCH_CONF"

  # --- 평문 시크릿. unit 파일과 nginx 설정은 644라 누구나 읽는다. ---
  local front_restart=0
  if grep -q '^Environment=COGNITO_CLIENT_SECRET=' "$FRONT_UNIT" 2>/dev/null; then
    umask 077
    grep '^Environment=COGNITO_CLIENT_SECRET=' "$FRONT_UNIT" \
      | sed 's/^Environment=//' > "$FRONT_ENV"
    umask 022
    chmod 600 "$FRONT_ENV"
    sed -i '/^Environment=COGNITO_CLIENT_SECRET=/d' "$FRONT_UNIT"
    front_restart=1
  fi
  if [ -e "$FRONT_ENV" ] && ! grep -q "^EnvironmentFile=$FRONT_ENV" "$FRONT_UNIT" 2>/dev/null; then
    mkdir -p "$FRONT_DROPIN"
    printf '[Service]\nEnvironmentFile=%s\n' "$FRONT_ENV" > "$FRONT_DROPIN/secret.conf"
    chmod 644 "$FRONT_DROPIN/secret.conf"
  fi
  # nginx 마스터는 root로 설정을 읽는다. X-Origin-Verify 값이 이 파일에 평문으로 있다.
  [ -e /etc/nginx/conf.d/aipds.conf ] && chmod 600 /etc/nginx/conf.d/aipds.conf

  # --- 스택이 남긴 값의 동기화(sync). 첫 실행은 켜고 2분 뒤 — boot는 이미 한 번 반영했다. ---
  cat > "/etc/systemd/system/$SYNC_UNIT.service" <<UNIT
[Unit]
Description=AI-PDS: apply sandbox and preview settings from SSM (aipds-harden sync)
[Service]
Type=oneshot
ExecStart=$LIBEXEC/harden sync
UNIT
  cat > "/etc/systemd/system/$SYNC_UNIT.timer" <<UNIT
[Unit]
Description=AI-PDS: aipds-harden sync every 2 minutes
[Timer]
OnActiveSec=2min
OnUnitActiveSec=2min
[Install]
WantedBy=timers.target
UNIT

  systemctl daemon-reload
  systemctl enable --now "$SYNC_UNIT.timer" >/dev/null 2>&1
  if [ "$restart" = 1 ]; then
    systemctl restart aipds-backend
    [ "$front_restart" = 1 ] && systemctl restart aipds-frontend
    echo "aipds-harden: installed; backend restarted (launcher and IMDS settings unchanged)"
  else
    echo "aipds-harden: installed (launcher and IMDS settings unchanged, services not restarted)"
  fi
}

case "${1:-}" in
  install)
    install_all "${2:-}"
    ;;
  boot)
    install_all --no-restart
    sync_apply 0
    ;;
  sync)
    [ -x "$LIBEXEC/preview-configure" ] || { echo "aipds-harden: run 'install' first" >&2; exit 1; }
    sync_apply 1
    ;;
  enable)
    ARN="${2:-}"
    case "$ARN" in
      arn:aws:iam::*:role/*) ;;
      *) echo "usage: aipds-harden enable <AgentRoleArn>" >&2; exit 1 ;;
    esac
    [ -x "$LIBEXEC/launch" ] || { echo "aipds-harden: run 'install' first" >&2; exit 1; }
    write_launcher "$ARN"
    rm -f "$HOLD"
    restart_backend
    ;;
  disable)
    rm -f "$DROPIN/launcher.conf"
    hold "disable"
    restart_backend
    ;;
  imds)
    case "${2:-}" in
      block) write_imds 1; rm -f "$HOLD" ;;
      allow) write_imds 0; hold "imds allow" ;;
      *) echo "usage: aipds-harden imds block|allow" >&2; exit 1 ;;
    esac
    # 상주 Discovery CLI는 기동할 때의 설정으로 계속 돈다. 재시작하면 기동 스윕이 그 unit을
    # 멈추고 다음 턴에 새 설정으로 뜬다.
    restart_backend
    ;;
  status)
    id aipds-agent aipds-proto 2>&1 || true
    ls -l "$LIBEXEC" "$SUDOERS" 2>&1 || true
    cat "$LAUNCH_CONF" 2>/dev/null || echo "no $LAUNCH_CONF"
    [ -e "$HOLD" ] && echo "sync held: $(cat "$HOLD")"
    systemctl list-timers --no-legend "$SYNC_UNIT.timer" 2>/dev/null || true
    ls "$DROPIN" 2>/dev/null || true
    runuser -u "$SVC" -- sudo -n "$LIBEXEC/launch" check 2>&1 || true
    systemctl list-units --no-legend 'aipds-run-*' 2>/dev/null || true
    ;;
  *)
    echo "usage: aipds-harden install|boot|sync|enable <arn>|disable|imds block|allow|status" >&2
    exit 1
    ;;
esac
